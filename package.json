{
  "name": "anime-role-grid",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "wrangler pages dev -- npm run dev",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "type-check": "vue-tsc -b && tsc -p functions/tsconfig.json && tsc -p workers/snapshot-refresh/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run type-check && npm run lint && npm run test:run"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@types/qrcode": "^1.5.6",
    "cropperjs": "^1.6.2",
    "driver.js": "^1.4.0",
    "drizzle-orm": "^0.45.1",
    "idb-keyval": "^6.2.2",
    "modern-screenshot": "^4.6.7",
    "mp4-muxer": "^5.2.2",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "uuid": "^13.0.0",
    "vue": "^3.5.24",
    "vue-draggable-plus": "^0.6.0",
    "vue-i18n": "^11.2.7",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9",
    "zod": "^4.3.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251217.0",
    "@eslint/js": "^9.39.5",
    "@iconify-json/carbon": "^1.2.14",
    "@types/node": "^24.10.1",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "@vueuse/core": "^14.1.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^27.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "unocss": "^66.5.9",
    "vite": "^7.2.4",
    "vitest": "^4.0.16",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.1.4",
    "wrangler": "^4.53.0"
